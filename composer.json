{
    "name": "patrickhanna/laravel-warden",
    "description": "Policy-based authorization and permissions for Laravel, with database-scoped ability checks.",
    "keywords": ["laravel", "authorization", "permissions", "policies", "access-control"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Warden\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Warden\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Warden\\WardenServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
